# Sentry. Everything is optional: without a DSN the SDK does nothing.
# Server and edge runtimes (never expose this one to the browser).
SENTRY_DSN=
# Browser runtime.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source map upload (set in Vercel / CI, never commit a token).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Where the app can reach itself over HTTP. Used only by the fetch() demo,
# which calls the app's own API. Defaults to http://localhost:3000 outside
# production; set it to the site URL in production or the demo stays disabled.
# SITE_ORIGIN=
